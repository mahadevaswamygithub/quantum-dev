# Copy to orchestrator/.env.prod and fill in real values before using
# docker-compose.prod.yml. DJANGO_API_BASE_URL / REDIS_URL / MEMORY_BACKEND /
# OLLAMA_BASE_URL are already set by docker-compose.prod.yml — only the LLM
# provider choice and its key(s) belong here.

# anthropic | openai | gemini | ollama
LLM_PROVIDER=ollama

# Required only for the matching provider above:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
