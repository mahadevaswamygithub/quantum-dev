# Copy to .env.prod and fill in real values before using docker-compose.prod.yml.
# Never commit the filled-in .env.prod — it's already covered by .gitignore's
# `.env*` pattern... but double check before pushing.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-value

DEBUG=False
# Comma-separated. Must include whatever hostname(s) clients will actually
# hit this container through (a domain, a reverse-proxy's name, etc).
ALLOWED_HOSTS=your-domain.com,.your-domain.com

# The primary hostname from ALLOWED_HOSTS above — used once at container
# startup to seed the django-tenants public Domain row (see
# bootstrap_public_tenant). Without a Domain row matching the hostname
# clients actually connect through, every /api/ request 404s.
PUBLIC_TENANT_DOMAIN=your-domain.com

DB_NAME=corex_db
DB_USER=postgres
DB_PASSWORD=change-me-to-a-strong-password

FRONTEND_URL=https://your-domain.com

# Only needed if you use "forgot password" / welcome emails:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@corex.com

# Razorpay TEST-mode (or live, once ready) keys — leave blank to keep the
# booking payment flow disabled (create_order returns 503 instead of crashing).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
