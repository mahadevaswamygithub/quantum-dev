# Copy to .env.prod and fill in real values before using docker-compose.prod.yml.
# Never commit the filled-in .env.prod — it's already covered by .gitignore's
# `.env*` pattern... but double check before pushing.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-value

DEBUG=False
# Comma-separated. Must include whatever hostname(s) clients will actually
# hit this container through (a domain, a reverse-proxy's name, etc).
ALLOWED_HOSTS=your-domain.com,.your-domain.com

# The primary hostname from ALLOWED_HOSTS above — used once at container
# startup to seed the django-tenants public Domain row (see
# bootstrap_public_tenant). Without a Domain row matching the hostname
# clients actually connect through, every /api/ request 404s.
PUBLIC_TENANT_DOMAIN=your-domain.com

DB_NAME=corex_db
DB_USER=postgres
DB_PASSWORD=change-me-to-a-strong-password

FRONTEND_URL=https://your-domain.com

# Only needed if you use "forgot password" / welcome emails:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@corex.com

# Razorpay TEST-mode (or live, once ready) keys — leave blank to keep the
# booking payment flow disabled (create_order returns 503 instead of crashing).
# --- Customer accounts ---------------------------------------------------------
# Hotels can sign up at /register; new accounts wait for the platform owner's approval.
ALLOW_PUBLIC_ORG_SIGNUP=False
# Hotels a self-signed-up customer may have until you raise it. Empty = no limit.
SIGNUP_PROPERTY_LIMIT=3

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Reliability (Phase 1) ---------------------------------------------------
# Shared cache for lockouts / rate limits across servers (default on in prod compose).
CACHE_USE_REDIS=True
# Booking emails through the Celery worker, with retries (default on in prod compose).
BOOKING_EMAILS_VIA_CELERY=True
LOG_FORMAT=json

# Uploads in S3-compatible object storage (needed for 2+ backend servers).
# AWS S3: leave S3_ENDPOINT_URL empty. Cloudflare R2 / Wasabi / MinIO: set it.
USE_S3=False
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN domain in front of the bucket, e.g. media.your-domain.com
S3_CUSTOM_DOMAIN=
S3_SIGNED_URLS=False

# Error tracking: errors arrive tagged with the request ID (X-Request-ID).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

