# Copy to backend.env (git-ignored) and fill in. Becomes the corex-secrets Secret.
# Non-secret settings (domain, flags) are in ../kustomization.yaml.

# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-value

# Managed Postgres (RDS, Cloud SQL, Azure Database...), with automated backups.
DB_HOST=your-postgres-host
DB_NAME=corex_db
DB_USER=corex
DB_PASSWORD=change-me

# Object storage for uploads. AWS S3: leave S3_ENDPOINT_URL empty.
# On EKS you can use an IAM role (IRSA) instead of keys.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_CUSTOM_DOMAIN=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@corex.com

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SENTRY_DSN=
