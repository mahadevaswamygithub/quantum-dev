# ==========================================
# CoreX Local Environment Configuration Template
# ==========================================
# Copy this file to .env and customize values as needed:
#   cp .env.example .env

# --- Django Core Settings ---
# Generate your own; never reuse a key that has been committed anywhere:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-generate-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=.ngrok-free.dev,localhost,127.0.0.1
# Public address of the web app. Used in email links (password reset, staff
# invites) and the booking-site QR code — must be your real domain (https://…)
# in production, or those links will point at localhost.
FRONTEND_URL=http://localhost:3000

# --- PostgreSQL Database ---
DB_NAME=corex_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# --- Redis & Celery (Optional for local dev) ---
REDIS_URL=redis://localhost:6379/0

# --- AI Chat Orchestrator (FastAPI) ---
LLM_ORCHESTRATOR_URL=http://localhost:8002

# --- Guest chat assistant on the booking site (/book) ---
# Built-in answers always work. Questions it doesn't recognise go to a private
# Ollama model with public facts only (no tools). Set False for built-in only.
GUEST_ASSISTANT_LLM=True
GUEST_ASSISTANT_LLM_URL=http://localhost:11434
GUEST_ASSISTANT_MODEL=llama3.2
GUEST_ASSISTANT_LLM_TIMEOUT=25
THROTTLE_ASSISTANT=30/min

# --- Email Notifications (SMTP) ---
# When testing locally without SMTP, console email backend is used if unset.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@corex.com

# --- Razorpay Payment Gateway (Test Mode) ---
# Get keys from https://dashboard.razorpay.com/app/keys
# Leave blank to return 503 instead of crashing when payment is initiated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the Razorpay webhook (Dashboard -> Settings -> Webhooks),
# pointing at https://<your-host>/api/bookings/razorpay/webhook/ for the
# payment.captured and order.paid events. Confirms bookings even when the
# customer closes the tab right after paying.
RAZORPAY_WEBHOOK_SECRET=

# --- Bookings ---
# Minutes an unpaid reservation holds its room before others can book it.
BOOKING_PAYMENT_WINDOW_MINUTES=15

# --- Stored secrets ---
# Key used to encrypt secrets saved in the database (e.g. a property's own SMTP
# password from Settings -> Email). Optional: derived from SECRET_KEY if blank,
# but set it in production so rotating SECRET_KEY doesn't make them unreadable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Guest booking emails ---
# Sent in the background after each booking change. False = send inline (debugging).
BOOKING_EMAILS_ASYNC=True

# --- Sign-in security ---
# Public "List your hotels on CoreX" sign-up at /register. New accounts wait for
# approval by the platform owner (role PLATFORM_ADMIN, /platform). Off: only the
# platform owner creates customer accounts.
ALLOW_PUBLIC_ORG_SIGNUP=False
# Hotels a self-signed-up customer may have until the platform owner raises it. Empty = no limit.
SIGNUP_PROPERTY_LIMIT=3
# Lock an email for LOGIN_LOCKOUT_MINUTES after LOGIN_MAX_FAILURES wrong passwords.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Access tokens are short; refresh tokens rotate and are revoked on logout/password change.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Browsers may only call the API from these web-app addresses (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Share lockout/rate-limit counters between server processes (production).
CACHE_USE_REDIS=False
# Roles that must use two-step verification (authenticator app); others can opt in.
TWO_FACTOR_REQUIRED_ROLES=MSP_ADMIN,PLATFORM_ADMIN

# --- Production hardening ---
# True once the site is served over https: http->https redirect, Secure cookies, HSTS.
HTTPS_ENABLED=False
# Reverse proxies in front of Django (nginx = 1). Needed for correct per-IP rate limits.
TRUSTED_PROXY_COUNT=0

# --- Production reliability (all off for local development) -----------------
# See .env.prod.example; `python manage.py check --deploy` lists what's missing.
USE_S3=False
BOOKING_EMAILS_VIA_CELERY=False
LOG_FORMAT=plain
SENTRY_DSN=

